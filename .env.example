# Supabase (Mumbai, ap-south-1). App traffic uses the transaction pooler (6543);
# migrations use the session pooler (5432). Replace YOUR_SUPABASE_DB_PASSWORD in both lines.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# Production: set this to the HTTPS domain assigned in Vercel (no trailing path).
APP_URL="http://localhost:3000"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

SMTP_URL=""
MAIL_FROM=""
CRON_SECRET=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
